# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT= 5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=database

# Redis
REDIS_ADDRESS=localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=qwe
RABBITMQ_ROUTING_KEY=notes
RABBITMQ_QUEUE=notes

# Email notifier
MAIL_FROM=notifier@notifier.com
MAIL_SUBJECT=Notification
MAIL_SMTP_ADDR=localhost:25

# Telegram notifier
TELEGRAM_TOKEN=***

# HTTP server
HTTP_PORT=8080
HTTP_HOST=localhost